# MongoDB connection
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER-NAME.mongodb.net/warrantdb?retryWrites=true&w=majority
MONGO_DB=warrantdb

# HTTP
PORT=8080

# CORS: allow your frontend origin (regex or literal)
# Example for local Vite dev server:
WEB_ORIGIN=http://localhost:5173

# Dashboard timezone (affects booking-day window calculations)
DASHBOARD_TZ=America/Chicago

# Google OAuth (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match the redirect URI configured on the Google OAuth client (defaults to API_PUBLIC_URL + /api/auth/google/callback)
GOOGLE_OAUTH_CALLBACK_URL=
# Public base URL of this API, used to build the Google OAuth callback URL
API_PUBLIC_URL=http://localhost:8080

# Session cookie secret (required in production) — generate with `openssl rand -hex 32`
SESSION_SECRET=

# Stripe (payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Enrichment providers
ENRICHMENT_PROVIDERS=pipl,whitepages
ENRICHMENT_CACHE_TTL_MINUTES=60
ENRICHMENT_ERROR_CACHE_TTL_MINUTES=15

# External enrichment service base URL (used by UI backend proxy at /api/enrichment/*)
# In local dev (Docker for Mac/Windows), host.docker.internal points to your host machine
# Example local service: http://localhost:4000
ENRICHMENT_API_URL=http://localhost:4000
# Optional: proxy timeout (ms) for forwarding requests to the enrichment service
ENRICHMENT_PROXY_TIMEOUT_MS=10000

# Whitepages (manual enrichment)
WHITEPAGES_API_KEY=
# Optional tuning
# WHITEPAGES_TIMEOUT_MS=8000
# WHITEPAGES_CACHE_TTL_MINUTES=60
# WHITEPAGES_ERROR_CACHE_TTL_MINUTES=15

# Pipl (manual enrichment)
PIPL_API_KEY=
# Optional tuning
# PIPL_TIMEOUT_MS=8000
# PIPL_CACHE_TTL_MINUTES=240
# PIPL_ERROR_CACHE_TTL_MINUTES=30

# SMTP (optional; enables emailing invite links)
# For local dev you can run MailHog (SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURE=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com

# App name for email subject/body
APP_NAME=Bail Bonds Dashboard
# GPS scheduling test interval (minutes between auto pings; dev only)
CHECKINS_GPS_INTERVAL_MINUTES=5
# Redis / queues
REDIS_URL=redis://localhost:6379/0
QUEUE_HEARTBEAT_MS=15000
MESSAGING_QUEUE_CONCURRENCY=5

# Telnyx Messaging
TELNYX_API_KEY=
# Provide either/both — a from-number alone is enough to send; a messaging
# profile ID additionally enables A2P 10DLC features.
TELNYX_MESSAGING_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
# Base64-encoded ed25519 public key from the Telnyx portal (API Keys /
# Webhooks tab), used to verify inbound webhook signatures.
TELNYX_PUBLIC_KEY=
# Optional overrides
# TELNYX_STATUS_CALLBACK_URL=http://localhost:8080/api/messages/telnyx/status
