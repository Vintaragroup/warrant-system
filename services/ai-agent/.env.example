# Base
APP_ENV=dev
BASE_URL=http://127.0.0.1:8082
SECRET_KEY=change_me_super_secret

# MongoDB
# Local sandbox (recommended for dev — see docs/architecture/OVERVIEW.md):
#   MONGO_URI="mongodb://localhost:27018"   (apps/dashboard's local Mongo, host-exposed port — this
#   service shares that database with the dashboard/pipeline so its simple_*/v2_* fast-path lookups
#   have real data to find; run via `uvicorn app.main:app --port 8082` on the host, not the
#   containerized ai-agent-api service, which deliberately stays on its own isolated Mongo — see
#   infra/docker/docker-compose.yml's comment on the checkins collection-name collision.)
# Production: real Atlas connection string, set directly in the Render dashboard (see
# infra/render/ai-agent.render.yaml — MONGO_URI is sync:false there on purpose).
MONGO_URI="mongodb://localhost:27018"
MONGO_DB=warrantdb

# AWS S3
AWS_ACCESS_KEY_ID=YOUR_AWS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
AWS_REGION=us-east-2
S3_BUCKET=rapidlocate-images

# Twilio (HTTP API creds OR leave blank if not using yet)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=+15551234567

# Telnyx Assistant Tools
TELNYX_TOOL_TOKEN="YOUR_TELNYX_TOOL_TOKEN_HERE"

# IP Geo (coarse fallback)
IP_GEO_PROVIDER=ipinfo   # ipinfo|ipapi|none
IP_GEO_TOKEN=            # ipinfo token or leave blank
# IP_GEO_TTL_SEC is NOT a declared Settings field (only consumed via raw
# os.getenv in geo.py, whose own default already matches) — including it here
# trips pydantic-settings' strict validation and the app refuses to boot.
# Leave commented out; only geo.py's hardcoded default (86400) applies.
# IP_GEO_TTL_SEC=86400

# Office routing (minimal transfer-only path)
# For a single universal transfer number, set DEFAULT_OFFICE_NUMBER and leave the rest blank.
# Example: DEFAULT_OFFICE_NUMBER=+18325550000
DEFAULT_OFFICE_NUMBER=
# Optional advanced routing (JSON strings). Not required for the minimal path.
# OFFICE_ROUTES_JSON='{"harris":"+18324100001","brazoria":"+18325550123"}'
# OFFICES_SCHEDULE_JSON='{"default":[{"days":["mon","tue","wed","thu","fri","sat","sun"],"start":"00:00","end":"23:59","numbers":["+18325550000"]}]}'

# ── Local dev quick test ────────────────────────────────────────────────────
# 1. python3 -m venv .venv && .venv/bin/pip install -r requirements.txt
# 2. cp .env.example .env, fill in real values (or point MONGO_URI at the
#    local sandbox as above)
# 3. .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8082
# 4. curl http://127.0.0.1:8082/healthz
# 5. All Telnyx Assistant tool endpoints are mounted under /telnyx (e.g.
#    POST /telnyx/find_person, /telnyx/get_bail_status, /telnyx/transfer_plan
#    — NOT at the bare path), and require `Authorization: Bearer
#    $TELNYX_TOOL_TOKEN`. Example:
#      curl -X POST http://127.0.0.1:8082/telnyx/find_person \
#        -H "Authorization: Bearer $TELNYX_TOOL_TOKEN" \
#        -H "Content-Type: application/json" \
#        -d '{"full_name":"LAST, FIRST","county":"harris"}'
