# warrant-system — root environment template
#
# Each service reads its own prefixed variables. The compose files in
# infra/docker/ translate these to the unprefixed names each service expects.
#
# Rules:
#   - Do not add a generic PORT= here. Each service port is set per-service below.
#   - Do not add a generic REDIS_URL= here. Use the per-service prefixed vars.
#   - Copy this file to .env and fill in real values. Never commit .env.
#   - Secrets must be non-empty before any public-facing Render deployment.

# ─── Shared ──────────────────────────────────────────────────────────────────

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info

# ─── warrantdb-pipeline ──────────────────────────────────────────────────────

# MongoDB connection for the pipeline service.
# The compose env block maps this to MONGO_URI inside the container.
#
# Current (per-service): mongodb://pipeline-mongo:27017/warrantdb_pipeline
# Future (shared):       mongodb://warrant-mongo:27017/?replicaSet=rs0
PIPELINE_MONGO_URI=mongodb://localhost:27017

# Database name used by the pipeline.
# Must differ from the dashboard and enrichment databases on a shared cluster.
# Future shared cluster: warrantdb_pipeline | inmate_enrichment | warrantdb
PIPELINE_MONGO_DB=warrantdb_pipeline

# Port the pipeline FastAPI service listens on.
PIPELINE_API_PORT=8081

# ─── inmate-enrichment ───────────────────────────────────────────────────────

# MongoDB connection for the enrichment service.
# The compose env block maps this to MONGO_URI inside the container.
#
# Current (per-service): mongodb://ie-mongo:27017/inmate_enrichment?replicaSet=rs0
# Future (shared):       mongodb://warrant-mongo:27017/?replicaSet=rs0
IE_MONGO_URI=mongodb://localhost:27017

# Database name used by the enrichment service.
# Must differ from the pipeline and dashboard databases on a shared cluster.
IE_MONGO_DB=inmate_enrichment

# Redis connection for the enrichment BullMQ worker.
# The compose env block maps this to REDIS_URL inside the container.
IE_REDIS_URL=redis://localhost:6379

# Port the enrichment Express API listens on.
IE_API_PORT=4000

# Shared secret between the dashboard proxy and the enrichment API.
# The dashboard sends this as x-enrichment-secret on every proxied request.
# The enrichment API validates it before processing any non-health request.
# Optional in local Docker dev (API is not host-exposed). Required for Render.
ENRICHMENT_PROXY_SECRET=

# Provider API keys — only needed when the corresponding provider is enabled.
# IE_PDL_API_KEY=
# IE_PIPL_API_KEY=
# IE_WHITEPAGES_API_KEY=
# IE_OPENAI_API_KEY=

# ─── bail-bonds-dashboard ────────────────────────────────────────────────────

# MongoDB connection for the dashboard service.
# The compose env block maps this to MONGO_URI inside the container.
# Deprecated aliases accepted by server/src/index.js (do not set these here;
# use DASHBOARD_MONGO_URI only): MONGODB_URI, MONGO_URL, ATLAS_URI, DATABASE_URL
#
# Current (per-service): mongodb://dashboard-mongo:27017/warrantdb
# Future (shared):       mongodb://warrant-mongo:27017/?replicaSet=rs0
DASHBOARD_MONGO_URI=mongodb://localhost:27017

# Database name used by the dashboard service.
# Must differ from the pipeline and enrichment databases on a shared cluster.
DASHBOARD_MONGO_DB=warrantdb

# Redis connection for the dashboard BullMQ worker.
# The compose env block maps this to REDIS_URL inside the container.
DASHBOARD_REDIS_URL=redis://localhost:6381

# Port the dashboard Express API listens on.
DASHBOARD_API_PORT=8080

# Port the Vite dev server listens on (local dev only; not used in production).
DASHBOARD_WEB_PORT=5173

# Session secret for the dashboard Express server. Required. No default.
# SESSION_SECRET=

# Firebase (required when auth is enabled)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=

# Stripe (required when payments are enabled)
# STRIPE_SECRET_KEY=

# Twilio (required when SMS is enabled)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ─── Frontend (Vite build-time) ───────────────────────────────────────────────

# Base URL the frontend uses to reach the dashboard API.
# In local dev this is http://localhost:8080. In production, the Render URL.
VITE_API_BASE_URL=http://localhost:8080

# Stripe publishable key (safe to include in client bundle).
VITE_STRIPE_PUBLISHABLE_KEY=
